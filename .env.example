# ---------------------------------------------------------------------------
# In locale: copia questo file in .env.local e compila i valori.
# Su Vercel: le stesse chiavi vanno in Project Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Dominio pubblico. In locale lascialo su localhost.
# Su Vercel puoi anche NON impostarlo: senza questa variabile il sito usa il
# dominio che Vercel espone da sé, invece di dichiarare un canonical inesistente.
# Impostalo al dominio definitivo appena lo registri.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# Senza queste due chiavi il sito gira sui contenuti dimostrativi: niente
# newsletter, niente registrazione, niente area riservata, niente admin.
# Ambienti Vercel: Production, Preview e Development.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave service role: pieni poteri sul database. Solo lato server.
# Su Vercel va marcata come Sensitive e non deve mai finire in una variabile
# che inizia per NEXT_PUBLIC_. Serve all'iscrizione alla newsletter,
# all'anteprima pubblica delle risorse e allo script `npm run db:seed`.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Email (facoltativo). Senza RESEND_API_KEY le email di conferma non partono:
# il link finisce nei log del server e confermi gli iscritti da /admin/iscritti.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Studio Aumentato <noreply@iltuodominio.it>"
