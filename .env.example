# ---------------------------------------------------------------------------
# Copia questo file in .env.local e compila i valori.
# ---------------------------------------------------------------------------

# Dominio pubblico del sito. Da questo valore derivano canonical, sitemap,
# feed RSS, dati strutturati e anteprime social: cambialo qui e basta.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave service role: solo lato server, non va mai nel browser né su Git.
# Serve per l'iscrizione alla newsletter e per lo script di seed.
SUPABASE_SERVICE_ROLE_KEY=

# Invio email (facoltativo). Senza questa chiave il sito funziona lo stesso:
# le email di conferma non partono e il link viene scritto nei log del server,
# così puoi confermare gli iscritti a mano dal pannello admin.
RESEND_API_KEY=
EMAIL_FROM="Studio Aumentato <noreply@iltuodominio.it>"
